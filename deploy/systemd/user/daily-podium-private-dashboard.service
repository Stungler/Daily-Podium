[Unit]
Description=Daily Podium private Tailscale dashboard
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/stefan/dev/Daily-Podium
ExecStart=/home/stefan/dev/Daily-Podium/.venv/bin/python -u -m daily_games.dashboard --host 100.118.9.35 --port 8765
Restart=always
RestartSec=15s
KillSignal=SIGINT
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
