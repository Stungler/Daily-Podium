[Unit]
Description=Daily Podium public leaderboard backend
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/stefan/dev/Daily-Podium
ExecStart=/home/stefan/dev/Daily-Podium/.venv/bin/python -u -m daily_games.public_dashboard --port 8766
Restart=always
RestartSec=15s
KillSignal=SIGINT
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
