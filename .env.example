# Generate on Developer Portal > Bot. Keep the real token in .env, never in Git/chat.
DISCORD_BOT_TOKEN=
# Optional: sync slash commands immediately to one development server.
# Leave empty to register commands globally (Discord propagation may take time).
DEV_GUILD_ID=
DATABASE_PATH=data/daily-games.sqlite3
LOG_LEVEL=INFO
# Optional dashboard: loopback by default. For bee's private tailnet use 100.118.9.35.
# These variables affect only the separate dashboard process, not the Discord bot.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
